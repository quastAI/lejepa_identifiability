#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @./materials/pbr.usda@
    ]
    upAxis = "Z"
)

def Xform "World"
{
    def Cube "Table" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/TableMaterial>
        double size = 1
        float3 xformOp:scale = (0.8, 0.6, 0.04)
        double3 xformOp:translate = (0.5, 0, 0.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "TablePedestal" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/TableMaterial>
        double size = 1
        float3 xformOp:scale = (0.1, 0.1, 0.38)
        double3 xformOp:translate = (0.5, 0, 0.19)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Cube" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/CubeMaterial>
        double size = 1
        float3 xformOp:scale = (0.06, 0.06, 0.06)
        double3 xformOp:translate = (0.5, 0, 0.45000000000000007)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "Lights"
    {
        def DomeLight "Dome"
        {
            color3f inputs:color = (0.85, 0.83, 0.8)
            float inputs:intensity = 1000
        }

        def RectLight "KeyLight"
        {
            float inputs:colorTemperature = 5500
            bool inputs:enableColorTemperature = 1
            float inputs:height = 0.4
            float inputs:intensity = 3000
            float inputs:width = 0.4
            double3 xformOp:translate = (0.2, -0.3, 1.4)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def RectLight "FillLight"
        {
            float inputs:colorTemperature = 5500
            bool inputs:enableColorTemperature = 1
            float inputs:height = 0.6
            float inputs:intensity = 800
            float inputs:width = 0.6
            double3 xformOp:translate = (0.9, 0.4, 1.2000000000000002)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def "Cameras"
    {
        def Camera "CameraL"
        {
            float2 clippingRange = (0.01, 100)
            float focalLength = 15.244857
            matrix4d xformOp:transform = ( (-0.6554701490532165, 0.7552210826639799, -5.5511151231257815e-17, 0), (-0.5819805015540729, -0.5051114896767804, 0.6373076798590877, 0), (0.48130819597324925, 0.41773615990999574, 0.7706094478999244, -0), (0.8747487373415292, 0.32525126265847093, 1.1, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }

        def Camera "CameraR"
        {
            float2 clippingRange = (0.01, 100)
            float focalLength = 15.244857
            matrix4d xformOp:transform = ( (-0.7552210826639799, 0.6554701490532165, 5.5511151231257815e-17, 0), (-0.5051114896767804, -0.5819805015540729, 0.6373076798590877, 0), (0.41773615990999574, 0.48130819597324925, 0.7706094478999244, -0), (0.8252512626584708, 0.3747487373415293, 1.1, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }
}

