#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    prepend references = @./stage_v1_tabletop.usda@</World>
)
{
    over "Looks"
    {
        def Material "RoomMaterial"
        {
            token outputs:surface.connect = </World/Looks/RoomMaterial/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.75, 0.74, 0.7)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }
    }

    def "Room"
    {
        def Cube "Floor" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Looks/RoomMaterial>
            double size = 1
            float3 xformOp:scale = (8.2, 8.2, 0.1)
            double3 xformOp:translate = (0.5, 0, -0.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Ceiling" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Looks/RoomMaterial>
            double size = 1
            float3 xformOp:scale = (8.2, 8.2, 0.1)
            double3 xformOp:translate = (0.5, 0, 4.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "WallNorth" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Looks/RoomMaterial>
            double size = 1
            float3 xformOp:scale = (8.2, 0.1, 4)
            double3 xformOp:translate = (0.5, 4.05, 2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "WallSouth" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Looks/RoomMaterial>
            double size = 1
            float3 xformOp:scale = (8.2, 0.1, 4)
            double3 xformOp:translate = (0.5, -4.05, 2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "WallEast" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Looks/RoomMaterial>
            double size = 1
            float3 xformOp:scale = (0.1, 8.2, 4)
            double3 xformOp:translate = (4.55, 0, 2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "WallWest" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </World/Looks/RoomMaterial>
            double size = 1
            float3 xformOp:scale = (0.1, 8.2, 4)
            double3 xformOp:translate = (-3.55, 0, 2)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }
}

